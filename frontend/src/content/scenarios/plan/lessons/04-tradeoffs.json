  "vars": {
    "savings": {
      "value": 20000,
      "fmt": "rupees"
    },
    "phone": {
      "value": 14600,
      "fmt": "rupees"
    },
    "coaching": {
      "value": 9000,
      "fmt": "rupees"
    },
    "years": {
      "value": 2,
      "fmt": "number"
    },
    "phoneLong": {
      "value": 14600,
      "fmt": "rupees"
    },
    "yearsLong": {
      "value": 4,
      "fmt": "number"
    },
    "cheapPhone": {
      "value": 9500,
      "fmt": "rupees"
    },
    "yearsCheap": {
      "value": 2,
      "fmt": "number"
    },
    "p5": {
      "value": 9000,
      "fmt": "rupees"
    },
    "y5": {
      "value": 3,
      "fmt": "number"
    },
    "inst": {
      "value": 1350,
      "fmt": "rupees"
    },
    "instMonths": {
      "value": 12,
      "fmt": "number"
    }
  },
  "calcs": [
    {
      "id": "both",
      "fn": "add",
      "args": [
        "$phone",
        "$coaching"
      ],
      "fmt": "rupees"
    },
    {
      "id": "shortfall",
      "fn": "sub",
      "args": [
        "$both",
        "$savings"
      ],
      "fmt": "rupees"
    },
    {
      "id": "days",
      "fn": "mul",
      "args": [
        "$years",
        365
      ],
      "fmt": "number"
    },
    {
      "id": "perDay",
      "fn": "div",
      "args": [
        "$phone",
        "$days"
      ],
      "fmt": "rupees"
    },
    {
      "id": "daysCheap",
      "fn": "mul",
      "args": [
        "$yearsCheap",
        365
      ],
      "fmt": "number"
    },
    {
      "id": "perDayCheap",
      "fn": "div",
      "args": [
        "$cheapPhone",
        "$daysCheap"
      ],
      "fmt": "rupees"
    },
    {
      "id": "daysLong",
      "fn": "mul",
      "args": [
        "$yearsLong",
        365
      ],
      "fmt": "number"
    },
    {
      "id": "perDayLong",
      "fn": "div",
      "args": [
        "$phoneLong",
        "$daysLong"
      ],
      "fmt": "rupees"
    },
    {
      "id": "months5",
      "fn": "mul",
      "args": [
        "$y5",
        12
      ],
      "fmt": "number"
    },
    {
      "id": "perMonth5",
      "fn": "div",
      "args": [
        "$p5",
        "$months5"
      ],
      "fmt": "rupees"
    },
    {
      "id": "instTotal",
      "fn": "mul",
      "args": [
        "$inst",
        "$instMonths"
      ],
      "fmt": "rupees"
    },
    {
      "id": "instExtra",
      "fn": "sub",
      "args": [
        "$instTotal",
        "$phone"
      ],
      "fmt": "rupees"
    },
    {
      "id": "extraPct",
      "fn": "percentOf",
      "args": [
        "$instExtra",
        "$phone"
      ],
      "fmt": "percent"
    }
  ],
