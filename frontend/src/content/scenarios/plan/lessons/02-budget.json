  "calcs": [
    {
      "id": "needsAmt",
      "fn": "mul",
      "args": [
        "$income",
        "$needsShare"
      ],
      "fmt": "rupees"
    },
    {
      "id": "wantsAmt",
      "fn": "mul",
      "args": [
        "$income",
        "$wantsShare"
      ],
      "fmt": "rupees"
    },
    {
      "id": "leftover",
      "fn": "sub",
      "args": [
        "$wantsAmt",
        "$wantsSpent"
      ],
      "fmt": "rupees"
    },
    {
      "id": "leanSave",
      "fn": "mul",
      "args": [
        "$leanMonth",
        "$saveShare"
      ],
      "fmt": "rupees"
    },
    {
      "id": "festMonthly",
      "fn": "div",
      "args": [
        "$festival",
        12
      ],
      "fmt": "rupees"
    }
