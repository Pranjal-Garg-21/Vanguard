{
  "id": "lesson_lending",
  "kind": "room",
  "pillar": "invest",
  "order": 4,
  "estMinutes": 10,
  "difficulty": "easy",
  "titleKey": "invest_lending.title",
  "blurbKey": "invest_lending.blurb",
  "concepts": ["lending_as_investing", "default_risk"],
  "misconceptions": ["high_rate_is_free_bonus", "guaranteed_returns_exist"],
  "vars": {
    "n": { "value": 8 },
    "amt": { "value": 1500, "fmt": "rupees" },
    "rate": { "value": 0.1, "fmt": "percent" },
    "b1": { "value": 8000, "fmt": "rupees" },
    "r1": { "value": 0.05, "fmt": "percent" },
    "l2": { "value": 2000, "fmt": "rupees" },
    "l2back": { "value": 2300, "fmt": "rupees" },
    "labAmt": { "value": 1000, "fmt": "rupees" },
    "labRate": { "value": 0.1, "fmt": "percent" },
    "labRecAll": { "value": 1, "fmt": "percent" },
    "rec40": { "value": 0.4, "fmt": "percent" },
    "r20": { "value": 0.2, "fmt": "percent" },
    "l5": { "value": 5000, "fmt": "rupees" }
  },
  "calcs": [
    { "id": "up", "fn": "add", "args": [1, "$rate"] },
    { "id": "amtBack", "fn": "mul", "args": ["$amt", "$up"], "fmt": "rupees" },
    { "id": "gain", "fn": "sub", "args": ["$amtBack", "$amt"], "fmt": "rupees" },
    { "id": "i1", "fn": "simpleInterest", "args": ["$b1", "$r1", 1], "fmt": "rupees" },
    { "id": "ret", "fn": "returnPct", "args": ["$l2", "$l2back"], "fmt": "percent" },
    { "id": "total", "fn": "mul", "args": ["$n", "$gain"], "fmt": "rupees" },
    { "id": "labLoss", "fn": "defaultLoss", "args": ["$labAmt", "$rec40"], "fmt": "rupees" },
    { "id": "labNet", "fn": "mul", "args": ["$labLoss", -1], "fmt": "rupees" },
    { "id": "gain20", "fn": "simpleInterest", "args": ["$labAmt", "$r20", 1], "fmt": "rupees" },
    { "id": "loss5", "fn": "defaultLoss", "args": ["$l5", "$rec40"], "fmt": "rupees" }
  ],
