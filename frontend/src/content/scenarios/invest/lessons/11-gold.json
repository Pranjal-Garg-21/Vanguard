        "$chargeAmt"
      ],
      "fmt": "rupees"
    },
    {
      "id": "up",
      "fn": "add",
      "args": [
        1,
        "$rise"
      ]
    },
    {
      "id": "sellVal",
      "fn": "mul",
      "args": [
        "$content",
        "$up"
      ],
      "fmt": "rupees"
    },
    {
      "id": "shortfall",
      "fn": "sub",
      "args": [
        "$price",
        "$sellVal"
      ],
      "fmt": "rupees"
    },
    {
      "id": "breakeven",
      "fn": "makingChargeBreakeven",
