{
  "id": "game_garden",
  "kind": "room",
  "pillar": "invest",
  "order": 102,
  "estMinutes": 12,
  "difficulty": "medium",
  "titleKey": "invest_garden.title",
  "blurbKey": "invest_garden.blurb",
  "concepts": ["interest_simple", "interest_compound", "simple_vs_compound", "start_early"],
  "misconceptions": ["interest_always_simple", "late_start_is_fine"],
  "vars": {
    "P": { "value": 10000, "fmt": "rupees" },
    "rate": { "value": 0.08, "fmt": "percent" },
    "ratePct": { "value": 8 },
    "yrs": { "value": 10 },
    "yrsLong": { "value": 20 },
    "rateM": { "value": 0.1, "fmt": "percent" },
    "monthly": { "value": 500, "fmt": "rupees" },
    "ageE": { "value": 18 },
    "ageL": { "value": 28 },
    "stop": { "value": 58 }
  },
  "calcs": [
    { "id": "interestS", "fn": "simpleInterest", "args": ["$P", "$rate", "$yrs"], "fmt": "rupees" },
    { "id": "comp10", "fn": "compoundAmount", "args": ["$P", "$rate", "$yrs"], "fmt": "rupees" },
    { "id": "extra", "fn": "interestOnInterest", "args": ["$P", "$rate", "$yrs"], "fmt": "rupees" },
    { "id": "comp20", "fn": "compoundAmount", "args": ["$P", "$rate", "$yrsLong"], "fmt": "rupees" },
    { "id": "doubling", "fn": "ruleOf72", "args": ["$ratePct"], "fmt": "number", "round": 0 },
    { "id": "yearsE", "fn": "sub", "args": ["$stop", "$ageE"] },
    { "id": "monthsE", "fn": "mul", "args": ["$yearsE", 12] },
    { "id": "yearsL", "fn": "sub", "args": ["$stop", "$ageL"] },
    { "id": "monthsL", "fn": "mul", "args": ["$yearsL", 12] },
    { "id": "earlyFV", "fn": "futureValueMonthly", "args": ["$monthly", "$rateM", "$monthsE"], "fmt": "rupees" },
    { "id": "lateFV", "fn": "futureValueMonthly", "args": ["$monthly", "$rateM", "$monthsL"], "fmt": "rupees" },
    { "id": "putEarly", "fn": "mul", "args": ["$monthly", "$monthsE"], "fmt": "rupees" },
    { "id": "putLate", "fn": "mul", "args": ["$monthly", "$monthsL"], "fmt": "rupees" },
    { "id": "morePut", "fn": "sub", "args": ["$putEarly", "$putLate"], "fmt": "rupees" },
    { "id": "gapFV", "fn": "sub", "args": ["$earlyFV", "$lateFV"], "fmt": "rupees" }
  ],
