            "amount": 1200,
            "months": 0
           }
          },
          {
           "do": {
            "type": "meter",
            "peace": 6
           }
          },
          {
           "say": "story.c4.card_yes",
           "who": "shauq"
          }
         ]
        },
        {
         "label": "choice.card_no",
         "log": {
          "concept": "credit_card",
          "choice": "declined",
          "correct": true
         },
         "do": [
          {
           "say": "story.c4.card_no",
           "who": "shauq"
          }
         ]
        }
       ],
       "prompt": "story.common.what_do"
      }
     ]
    }
   ]
  },
  {
   "choice": [
    {
     "label": "choice.shop",
     "do": [
      {
       "open": "shop:shauq"
      }
     ]
    },
    {
     "label": "choice.goal_buy",
     "when": "goalAt:shauq && !flag:goal_done",
