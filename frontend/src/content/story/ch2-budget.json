 ],
 "anwar": [
  {
   "once": "anwar_intro",
   "do": [
    {
     "say": "story.c2.anwar1",
     "who": "anwar"
    },
    {
     "say": "story.c2.anwar2",
     "who": "anwar"
    },
    {
     "concept": "gst"
    }
   ]
  },
  {
   "if": "month>=2",
   "then": [
    {
     "once": "inflation_seen",
     "do": [
      {
       "say": "story.c2.anwar_inflation",
       "who": "anwar"
      },
      {
       "concept": "inflation"
      }
     ]
    }
   ]
  },
  {
   "choice": [
    {
     "label": "choice.shop",
     "do": [
      {
       "open": "shop:zaroorat"
      }
     ]
    },
    {
     "label": "choice.goal_buy",
     "when": "goalAt:anwar && !flag:goal_done",
     "do": [
      {
       "call": "goal_buy"
      }
     ]
    },
    {
     "label": "choice.challenge",
     "when": "chapter==2 && monthsInChapter>=2",
     "do": [
      {
       "say": "story.c2.anwar_challenge",
       "who": "anwar"
      },
      {
       "quiz": [
        "budget_needs",
        "budget_rule",
        "budget_sale",
        "budget_first"
       ],
       "pass": 3,
       "then": [
        {
         "say": "story.c2.anwar_pass",
         "who": "anwar"
        },
        {
         "badge": "budget"
        },
        {
         "chapter": 3
        },
        {
         "objective": "objective.ch3_home"
        }
       ],
       "else": [
        {
         "say": "story.c2.anwar_fail",
         "who": "anwar"
        }
       ]
      }
     ]
    },
    {
     "label": "choice.bye"
    }
   ],
   "prompt": "story.c2.anwar_menu",
   "who": "anwar"
  }
 ],
 "shauq": [
  {
   "once": "shauq_intro",
   "do": [
