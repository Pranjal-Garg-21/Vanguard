     "who": "shauq"
    },
    {
     "concept": "sales_tricks"
    }
   ]
  },
  {
   "if": "chapter==2 && goalKind:consumption && !flag:goal_done && account",
   "then": [
    {
     "once": "emi_offer",
     "do": [
      {
       "checkpoint": "checkpoint.emi_offer"
      },
      {
       "say": "story.c2.shauq_emi",
       "who": "shauq"
      },
      {
       "choice": [
        {
         "label": "choice.emi_take",
         "log": {
          "concept": "delayed_gratification",
          "choice": "buy_now_card",
          "correct": false,
          "misconception": "buy_now_pay_later_is_free"
         },
         "do": [
          {
           "do": {
            "type": "buyGoal",
            "onCard": true
           }
          },
          {
           "toast": "toast.goal"
          },
          {
           "say": "story.c2.emi_taken",
           "who": "shauq"
          }
         ]
        },
        {
         "label": "choice.emi_save",
         "log": {
          "concept": "delayed_gratification",
          "choice": "save_first",
          "correct": true
         },
         "do": [
          {
           "say": "story.c2.emi_saved",
           "who": "shauq"
          }
         ]
        }
       ],
       "prompt": "story.common.what_do"
      },
      {
       "concept": "delayed_gratification"
      }
     ]
    }
   ]
  },
  {
   "if": "chapter>=4",
   "then": [
    {
     "once": "bnpl_offer",
