  "prof_ch3": [
    {
      "if": "goalKind:education",
      "then": [
        {
          "once": "scholarship_test",
          "do": [
            {
              "say": "story.c3.prof_scholarship",
              "who": "professor"
            },
            {
              "concept": "scholarships"
            },
            {
              "quiz": [
                "save_inflation",
                "budget_rule"
              ],
              "pass": 1,
              "then": [
                {
                  "say": "story.c3.scholarship_won",
                  "who": "professor"
                },
                {
                  "do": {
                    "type": "gain",
                    "amount": 1500,
                    "reason": "scholarship"
                  }
                },
                {
                  "do": {
                    "type": "toPot",
                    "amount": 1500
                  }
                }
              ],
              "else": [
                {
                  "say": "story.c3.scholarship_lost",
                  "who": "professor"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "say": "story.c3.prof_hint",
      "who": "professor"
    }
  ]
