{
  "crack": [
    {
      "checkpoint": "checkpoint.crack"
    },
    {
      "say": "story.c3.crack1"
    },
    {
      "say": "story.c3.crack2"
    },
    {
      "if": "bank>=1500",
      "then": [
        {
          "say": "story.c3.crack_fund"
        }
      ],
      "else": [
        {
          "say": "story.c3.crack_nofund"
        }
      ]
    },
    {
      "choice": [
        {
          "label": "choice.crack_savings",
          "when": "bank>=1500",
          "log": {
            "concept": "emergency_fund",
            "choice": "paid_savings",
            "correct": true
          },
          "do": [
            {
              "do": {
                "type": "spend",
                "amount": 1500,
                "reason": "repair:phone",
                "from": "bank"
              }
            },
            {
              "say": "story.c3.crack_paid"
            }
          ]
        },
        {
          "label": "choice.crack_cash",
          "when": "cash>=1500",
          "log": {
            "concept": "emergency_fund",
            "choice": "paid_cash",
            "correct": true
          },
          "do": [
            {
              "do": {
                "type": "spend",
                "amount": 1500,
                "reason": "repair:phone",
                "from": "cash"
              }
            },
            {
              "say": "story.c3.crack_paid"
            }
          ]
        },
        {
          "label": "choice.crack_mom",
          "when": "!loan:family",
          "log": {
            "concept": "emergency_fund",
            "choice": "borrow_family",
            "correct": false
          },
          "do": [
            {
              "do": {
                "type": "takeLoan",
                "kind": "family",
                "amount": 1500,
                "months": 5
              }
            },
            {
              "do": {
                "type": "spend",
                "amount": 1500,
                "reason": "repair:phone",
                "from": "bank"
              }
            },
            {
              "say": "story.c3.crack_mom",
              "who": "mom"
            }
          ]
        },
        {
          "label": "choice.crack_skip",
          "log": {
            "concept": "emergency_fund",
            "choice": "skip",
            "correct": false
          },
          "do": [
            {
              "do": {
                "type": "meter",
                "peace": -15
              }
            },
            {
              "say": "story.c3.crack_skip"
            }
          ]
        }
      ],
      "prompt": "story.common.what_do"
    },
    {
      "concept": "emergency_fund"
    },
    {
      "flag": "phone_cracked"
    },
    {
      "objective": "objective.ch3_lakshmi"
    }
  ],
  "lakshmi": [
    {
      "once": "lakshmi_intro",
      "do": [
        {
          "say": "story.c3.lakshmi1",
          "who": "lakshmi"
        },
        {
          "say": "story.c3.lakshmi2",
          "who": "lakshmi"
        },
        {
          "concept": "compound_interest"
        },
        {
          "say": "story.c3.lakshmi3",
          "who": "lakshmi"
        },
        {
          "concept": "rule_of_72"
        },
        {
          "say": "story.c3.lakshmi4",
          "who": "lakshmi"
        },
        {
          "concept": "fixed_deposit"
        },
        {
          "say": "story.c3.lakshmi5",
          "who": "lakshmi"
        },
        {
          "concept": "net_worth"
        },
        {
          "flag": "met_lakshmi"
        },
        {
          "objective": "objective.ch3_fund"
        }
      ]
    },
    {
      "if": "chapter==3",
      "then": [
        {
          "if": "fundMonths>=3 && monthsInChapter>=2 || monthsInChapter>=4",
          "then": [
            {
              "say": "story.c3.lakshmi_ready",
              "who": "lakshmi"
            },
            {
              "choice": [
                {
                  "label": "choice.challenge_yes",
                  "do": [
                    {
                      "quiz": [
                        "save_emergency",
                        "save_compound",
                        "save_72",
                        "save_inflation"
                      ],
                      "pass": 3,
                      "then": [
                        {
                          "say": "story.c3.lakshmi_pass",
                          "who": "lakshmi"
                        },
                        {
                          "badge": "saver"
                        },
                        {
                          "chapter": 4
                        },
                        {
                          "objective": "objective.ch4_prof"
                        }
                      ],
                      "else": [
                        {
                          "say": "story.c3.lakshmi_fail",
                          "who": "lakshmi"
                        }
                      ]
                    }
                  ]
                },
                {
                  "label": "choice.not_yet"
                }
              ],
              "who": "lakshmi"
            }
          ],
          "else": [
            {
              "say": "story.c3.lakshmi_notyet",
              "who": "lakshmi"
            }
          ]
        }
      ],
      "else": [
        {
          "say": "story.c3.lakshmi_later",
          "who": "lakshmi"
        }
      ]
    }
  ],
  "job_scam": [
    {
      "checkpoint": "checkpoint.job"
    },
    {
      "toast": "toast.sms"
    },
    {
      "say": "story.c3.jobsms",
      "who": "phone"
    },
    {
      "duel": "job_task",
      "win": [
        {
          "say": "story.c3.job_ignore"
        },
        {
          "do": {
            "type": "meter",
            "safety": 5
          }
        }
      ],
      "lose": [
        {
          "do": {
            "type": "scamLoss",
            "amount": 500,
            "reason": "scam:job"
          }
        },
        {
          "say": "story.c3.job_paid"
        }
      ]
    },
    {
      "concept": "job_scam"
    },
    {
      "flag": "job_scam_done"
    }
  ],
  "kabir": [
