{
  "id": "lesson_funds",
  "kind": "room",
  "pillar": "invest",
  "order": 9,
  "estMinutes": 14,
  "difficulty": "medium",
  "titleKey": "invest_funds.title",
  "blurbKey": "invest_funds.blurb",
  "concepts": ["pooled_funds", "sip_concept", "fees_cost", "diversification"],
  "misconceptions": ["guaranteed_returns_exist", "sip_guarantees_profit", "higher_fee_means_better", "best_fund_exists", "past_returns_repeat"],
  "vars": {
    "people": { "value": 100 },
    "each": { "value": 1000, "fmt": "rupees" },
    "pool": { "value": 600000, "fmt": "rupees" },
    "units": { "value": 5000 },
    "buyAmt": { "value": 6000, "fmt": "rupees" },
    "sipAmt": { "value": 2000, "fmt": "rupees" },
    "nav1": { "value": 100, "fmt": "rupees" },
    "nav2": { "value": 80, "fmt": "rupees" },
    "nav3": { "value": 125, "fmt": "rupees" },
    "nav4": { "value": 100, "fmt": "rupees" },
    "sipM": { "value": 1000, "fmt": "rupees" },
    "gross": { "value": 0.1, "fmt": "percent" },
    "yrs": { "value": 10 },
    "feeLow": { "value": 0.005, "fmt": "percent", "round": 1 },
    "feeHigh": { "value": 0.02, "fmt": "percent" }
  },
  "calcs": [
    { "id": "potTot", "fn": "mul", "args": ["$people", "$each"], "fmt": "rupees" },
    { "id": "nav", "fn": "navPerUnit", "args": ["$pool", "$units"], "fmt": "rupees" },
    { "id": "unitsGot", "fn": "unitsBought", "args": ["$buyAmt", "$nav"], "fmt": "number", "round": 0 },
    { "id": "u1", "fn": "unitsBought", "args": ["$sipAmt", "$nav1"], "fmt": "number", "round": 1 },
    { "id": "u2", "fn": "unitsBought", "args": ["$sipAmt", "$nav2"], "fmt": "number", "round": 1 },
    { "id": "u3", "fn": "unitsBought", "args": ["$sipAmt", "$nav3"], "fmt": "number", "round": 1 },
    { "id": "u4", "fn": "unitsBought", "args": ["$sipAmt", "$nav4"], "fmt": "number", "round": 1 },
    { "id": "u12", "fn": "add", "args": ["$u1", "$u2"] },
    { "id": "u123", "fn": "add", "args": ["$u12", "$u3"] },
    { "id": "uTotal", "fn": "add", "args": ["$u123", "$u4"], "fmt": "number", "round": 0 },
    { "id": "months", "fn": "mul", "args": ["$yrs", 12] },
    { "id": "rLow", "fn": "sub", "args": ["$gross", "$feeLow"] },
    { "id": "rHigh", "fn": "sub", "args": ["$gross", "$feeHigh"] },
    { "id": "netLow", "fn": "futureValueMonthly", "args": ["$sipM", "$rLow", "$months"], "fmt": "rupees" },
    { "id": "netHigh", "fn": "futureValueMonthly", "args": ["$sipM", "$rHigh", "$months"], "fmt": "rupees" },
    { "id": "gap", "fn": "sub", "args": ["$netLow", "$netHigh"], "fmt": "rupees" },
    { "id": "putIn", "fn": "mul", "args": ["$sipM", "$months"], "fmt": "rupees" }
  ],
  "tasks": [
    {
      "id": "t1",
      "titleKey": "invest_funds.t1.title",
