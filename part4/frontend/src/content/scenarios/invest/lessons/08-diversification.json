    { "id": "mWidth", "fn": "sub", "args": ["$mHigh", "$mLow"], "fmt": "rupees" },
    { "id": "bLow", "fn": "typicalLow", "args": ["$amt", "$bMean", "$bFee", "$bVol"], "fmt": "rupees" },
    { "id": "bHigh", "fn": "typicalHigh", "args": ["$amt", "$bMean", "$bFee", "$bVol"], "fmt": "rupees" },
    { "id": "bWidth", "fn": "sub", "args": ["$bHigh", "$bLow"], "fmt": "rupees" },
    { "id": "narrower", "fn": "sub", "args": ["$bWidth", "$mWidth"], "fmt": "rupees" }
