    "bFee": { "value": 0.005, "fmt": "percent", "round": 1 },
    "bVol": { "value": 0.22, "fmt": "percent", "round": 1 }
  },
  "calcs": [
    { "id": "each", "fn": "div", "args": ["$total", "$count"], "fmt": "rupees" },
    { "id": "lossOne", "fn": "mul", "args": ["$total", "$fall"], "fmt": "rupees" },
    { "id": "lossSplit", "fn": "div", "args": ["$lossOne", "$count"], "fmt": "rupees" },
    { "id": "lossMarket", "fn": "identity", "args": ["$lossOne"], "fmt": "rupees" },
    { "id": "mLow", "fn": "typicalLow", "args": ["$amt", "$mMean", "$mFee", "$mVol"], "fmt": "rupees" },
