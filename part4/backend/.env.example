# Backend secrets. Copy to backend/.env and fill in.
# backend/.env is git-ignored. NEVER commit real values, and never copy
# anything from this file into frontend/.

# Project ref: the id in your dashboard URL (supabase.com/dashboard/project/<ref>)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API Keys → Secret keys (sb_secret_...).
# Full access to the database, bypassing row-level security. For admin scripts
# only (seeding demo data, creating facilitators). Edge functions get their own
# copy from Supabase automatically.
SUPABASE_SECRET_KEY=

# The database password you set when creating the project.
# Used by `npx supabase link` / `db push` when you don't want the prompt.
SUPABASE_DB_PASSWORD=

# Optional: personal access token (supabase.com/dashboard/account/tokens),
# lets the CLI work without `npx supabase login`.
SUPABASE_ACCESS_TOKEN=
