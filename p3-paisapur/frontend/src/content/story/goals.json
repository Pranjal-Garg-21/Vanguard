  ],
  "festival_rush": [
    {
      "checkpoint": "checkpoint.windfall"
    },
    {
      "say": "story.src.festival1"
    },
    {
      "do": {
        "type": "gain",
        "amount": 1000,
        "reason": "windfall"
      }
    },
    {
      "concept": "windfall"
    },
    {
      "choice": [
        {
          "label": "choice.windfall_all",
          "log": {
            "concept": "windfall",
            "choice": "save_all",
            "correct": true
          },
          "do": [
            {
              "do": {
                "type": "toPot",
                "amount": 1000
              }
            },
            {
              "say": "story.src.windfall_saved"
            }
          ]
        },
        {
          "label": "choice.windfall_most",
          "log": {
            "concept": "windfall",
            "choice": "save_most",
            "correct": true
          },
          "do": [
            {
              "do": {
                "type": "toPot",
                "amount": 700
              }
            },
            {
              "do": {
                "type": "meter",
                "peace": 3
              }
            },
            {
              "say": "story.src.windfall_most"
            }
          ]
        },
        {
          "label": "choice.windfall_spend",
          "log": {
            "concept": "windfall",
            "choice": "spend_all",
            "correct": false
          },
          "do": [
            {
              "do": {
                "type": "spend",
                "amount": 1000,
                "reason": "buy:wants"
              }
            },
            {
              "do": {
                "type": "meter",
                "peace": 6
              }
            },
            {
              "say": "story.src.windfall_spent"
            }
          ]
        }
      ],
      "prompt": "story.src.windfall_q"
    },
    {
      "flag": "festival_done"
    }
  ],
  "scholarship_lump": [
    {
      "checkpoint": "checkpoint.windfall"
    },
    {
      "say": "story.src.lump1"
    },
    {
      "do": {
        "type": "gain",
        "amount": 3000,
        "reason": "scholarship"
      }
    },
    {
      "concept": "windfall"
    },
    {
      "choice": [
        {
          "label": "choice.lump_plan",
          "log": {
            "concept": "windfall",
            "choice": "spread",
            "correct": true
          },
          "do": [
            {
              "do": {
                "type": "toPot",
                "amount": 2000
              }
            },
            {
              "say": "story.src.lump_plan"
            }
          ]
        },
        {
          "label": "choice.lump_spend",
          "log": {
            "concept": "windfall",
            "choice": "spend",
            "correct": false
          },
          "do": [
            {
              "do": {
                "type": "spend",
                "amount": 2500,
                "reason": "buy:wants"
              }
            },
            {
              "do": {
                "type": "meter",
                "peace": 5
              }
            },
            {
              "say": "story.src.lump_spent"
            }
          ]
        }
      ],
      "prompt": "story.src.windfall_q"
    },
    {
      "flag": "scholarship_done"
    }
  ],
  "grocery_week": [
    {
      "say": "story.src.grocery1",
      "who": "mom"
    },
    {
      "choice": [
        {
          "label": "choice.grocery_list",
          "log": {
            "concept": "budgeting",
            "choice": "list_compare",
            "correct": true
          },
          "do": [
            {
              "say": "story.src.grocery_good",
              "who": "mom"
            },
            {
              "do": {
                "type": "gain",
                "amount": 150,
                "reason": "gift"
              }
            }
          ]
        },
        {
          "label": "choice.grocery_first",
          "log": {
            "concept": "budgeting",
            "choice": "first_brand",
            "correct": false
          },
          "do": [
            {
              "say": "story.src.grocery_meh",
              "who": "mom"
            }
          ]
        },
        {
          "label": "choice.grocery_snacks",
          "log": {
            "concept": "needs_wants",
            "choice": "snacks",
            "correct": false
          },
          "do": [
            {
              "say": "story.src.grocery_bad",
              "who": "mom"
            },
            {
              "do": {
                "type": "meter",
                "trust": -5
              }
            }
          ]
        }
      ],
      "prompt": "story.src.grocery_q"
    },
    {
      "flag": "grocery_done"
    }
  ],
  "lean_month": [
    {
      "if": "source:tutoring",
      "then": [
        {
          "say": "story.src.lean_tutoring"
        },
        {
          "do": {
            "type": "adjustIncome",
            "in": 1,
            "factor": 0.3
          }
        }
      ]
    },
    {
      "if": "source:shop",
      "then": [
        {
          "say": "story.src.lean_shop"
        },
        {
          "do": {
            "type": "adjustIncome",
            "in": 1,
            "factor": 0.5
          }
        }
      ]
    },
    {
      "if": "source:allowance",
      "then": [
        {
          "say": "story.src.lean_allowance",
          "who": "mom"
        },
        {
          "do": {
            "type": "adjustIncome",
            "in": 1,
            "factor": 0.75
          }
        }
      ]
    },
    {
      "concept": "irregular_income"
    },
    {
      "say": "story.src.lean_tip"
    },
    {
      "flag": "lean_done"
    }
  ]
}
