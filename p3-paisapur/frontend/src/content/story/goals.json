{
  "goal_buy": [
    {
      "if": "flag:goal_done",
      "then": [
        {
          "say": "story.goal.already"
        },
        {
          "end": true
        }
      ]
    },
    {
      "checkpoint": "checkpoint.goal"
    },
    {
      "if": "goalGap<=0",
      "then": [
        {
          "say": "story.goal.ready"
        },
        {
          "choice": [
            {
              "label": "choice.goal_buy_yes",
              "do": [
                {
                  "do": {
                    "type": "buyGoal"
                  }
                },
                {
                  "toast": "toast.goal"
                },
                {
                  "if": "flag:goal_on_loan",
                  "then": [
                    {
                      "say": "story.goal.bought_loan"
                    }
                  ],
                  "else": [
                    {
                      "say": "story.goal.bought_saved"
                    }
                  ]
                },
                {
                  "concept": "delayed_gratification"
                },
                {
                  "if": "goalKind:asset",
                  "then": [
                    {
                      "say": "story.goal.done_asset"
                    },
                    {
                      "concept": "assets_that_earn"
                    }
                  ]
                },
                {
                  "if": "goalKind:education",
                  "then": [
                    {
                      "say": "story.goal.done_education"
                    }
                  ]
                },
                {
                  "if": "goalKind:consumption",
                  "then": [
                    {
                      "say": "story.goal.done_consumption"
                    },
                    {
                      "concept": "depreciation"
                    }
                  ]
                },
                {
                  "if": "goalKind:quick",
                  "then": [
                    {
                      "say": "story.goal.done_quick"
                    }
                  ]
                },
                {
                  "call": "goal_next"
                }
              ]
            },
            {
              "label": "choice.goal_buy_wait",
              "do": [
                {
                  "say": "story.goal.wait"
                }
              ]
            }
          ],
          "prompt": "story.goal.ready_q"
        }
      ],
      "else": [
        {
          "say": "story.goal.not_enough"
        },
        {
          "if": "chapter>=4",
          "then": [
            {
              "say": "story.goal.loan_hint"
            }
          ]
        }
      ]
    }
  ],
